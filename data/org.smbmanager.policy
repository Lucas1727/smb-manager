<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SMB Manager</vendor>

  <action id="org.smbmanager.manage-shares">
    <description>Manage SMB shared folders</description>
    <message>Authentication is required to change shared folders</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- auth_admin_keep: admins authenticate once, then a short grace
           period so adding several shares doesn't prompt every time. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
